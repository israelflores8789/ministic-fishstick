{
  "name": "ministic-fishstick-vscode",
  "displayName": "Ministic Fishstick MCP - Semantic Code Indexer",
  "description": "VS Code and GitHub Copilot Agent integration for ministic-fishstick semantic code search MCP server",
  "version": "0.1.0",
  "publisher": "ministic",
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": ["AI", "Programming Languages"],
  "main": "./out/extension.js",
  "activationEvents": ["onStartupFinished"],
  "contributes": {
    "commands": [
      {
        "command": "fishstick.startIndexing",
        "title": "Fishstick: Start Codebase Indexing"
      },
      {
        "command": "fishstick.searchCode",
        "title": "Fishstick: Search Codebase"
      }
    ],
    "mcpServers": {
      "fishstick": {
        "command": "bun",
        "args": ["run", "${workspaceFolder}/node_modules/ministic-fishstick/src/index.ts"],
        "env": {
          "VECTOR_STORE_PROVIDER": "sqlite"
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "bun run build",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./"
  },
  "devDependencies": {
    "@types/vscode": "^1.90.0",
    "typescript": "^5.7.3"
  }
}
