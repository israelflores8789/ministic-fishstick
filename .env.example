# Target workspace directory to index (defaults to current working directory)
WORKSPACE_PATH=.

# Vector Store Provider: "sqlite" (default local zero-docker) or "qdrant"
VECTOR_STORE_PROVIDER=sqlite

# Qdrant configuration (required if VECTOR_STORE_PROVIDER=qdrant)
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=

# Default Embedding Provider: "openai"
EMBEDDER_PROVIDER=openai
OPENAI_API_KEY=your-openai-api-key
EMBEDDER_MODEL_ID=text-embedding-3-small

# Optional search parameters
SEARCH_MIN_SCORE=0.3
SEARCH_MAX_RESULTS=20
