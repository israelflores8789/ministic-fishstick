{
  "name": "ministic-fishstick",
  "author": "Israel Flores-Arbolay <israelflores8789@gmail.com>",
  "version": "0.1.0",
  "license": "Apache-2.0",
  "description": "Minimal MCP server for semantic code indexing and vector search powered by Bun",
  "main": "src/index.ts",
  "module": "src/index.ts",
  "type": "module",
  "bin": {
    "fishstick-mcp": "src/index.ts"
  },
  "scripts": {
    "start": "bun run src/index.ts",
    "dev": "bun --watch run src/index.ts",
    "check-types": "tsc --noEmit",
    "test": "bun test",
    "build": "bun build ./src/index.ts --outdir ./dist --target bun"
  },
  "dependencies": {
    "@aws-sdk/client-bedrock-runtime": "^3.1111.0",
    "@aws-sdk/credential-providers": "^3.1111.0",
    "@google/genai": "^0.2.0",
    "@logtape/file": "^2.3.1",
    "@logtape/logtape": "^2.3.1",
    "@mistralai/mistralai": "^1.15.1",
    "@modelcontextprotocol/server": "^2.0.0",
    "@qdrant/js-client-rest": "^1.19.0",
    "async-mutex": "^0.5.0",
    "chokidar": "^4.0.3",
    "dotenv": "^16.6.1",
    "i18next": "^26.3.6",
    "ignore": "^7.0.6",
    "ollama": "^0.5.18",
    "openai": "^4.104.0",
    "p-limit": "^6.2.0",
    "serialize-error": "^12.0.0",
    "tree-sitter-wasms": "^0.1.13",
    "uuid": "^11.1.1",
    "web-tree-sitter": "^0.26.12",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/node": "^22.20.1",
    "@types/uuid": "^10.0.0",
    "prettier": "^3.9.6",
    "typescript": "^5.9.3"
  }
}
