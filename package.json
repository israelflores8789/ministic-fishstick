{
  "name": "ministic-fishstick",
  "version": "0.1.0",
  "description": "Minimal MCP server for semantic code indexing and vector search powered by Bun",
  "main": "src/index.ts",
  "module": "src/index.ts",
  "type": "module",
  "bin": {
    "fishstick-mcp": "src/index.ts"
  },
  "scripts": {
    "start": "bun run src/index.ts",
    "dev": "bun --watch run src/index.ts",
    "check-types": "tsc --noEmit",
    "test": "bun test",
    "build": "bun build ./src/index.ts --outdir ./dist --target bun"
  },
  "dependencies": {
    "@aws-sdk/client-bedrock-runtime": "^3.750.0",
    "@google/genai": "^0.2.0",
    "@mistralai/mistralai": "^1.5.0",
    "@modelcontextprotocol/sdk": "^1.6.0",
    "@qdrant/js-client-rest": "^1.14.0",
    "async-mutex": "^0.5.0",
    "chokidar": "^4.0.1",
    "dotenv": "^16.4.7",
    "ignore": "^7.0.3",
    "ollama": "^0.5.14",
    "openai": "^4.86.1",
    "p-limit": "^6.2.0",
    "serialize-error": "^12.0.0",
    "tree-sitter-wasms": "^0.1.13",
    "uuid": "^11.1.0",
    "web-tree-sitter": "^0.25.6",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/node": "^22.13.0",
    "@types/uuid": "^10.0.0",
    "typescript": "^5.7.3"
  }
}
